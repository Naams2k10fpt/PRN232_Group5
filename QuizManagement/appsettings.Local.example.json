{
  "ConnectionStrings": {
    // Local: docker compose up db (or a local PostgreSQL). Neon: use the key/value form, not the postgresql:// URI.
    "DefaultConnection": "Host=localhost;Port=5432;Database=quizmanagement;Username=postgres;Password=postgres"
  },
  "AdminSeed": {
    "Enabled": false,
    "Username": "Admin",
    "Email": "admin@example.local",
    "Password": "replace-with-a-strong-password"
  },
  "Jwt": {
    // Bearer tokens for the mobile API. Leave SigningKey empty in Development to use a random per-run key
    // (tokens then stop working after a restart). Outside Development it is required: a random secret of 32+ bytes.
    "SigningKey": "",
    "AccessTokenMinutes": 10080
  },
  "Email": {
    // Log: emails (with their verification/reset links) are written to the console. Development only.
    // Smtp: set Host/Port/EnableSsl/Username/Password. BrevoApi: set ApiKey and a Brevo-verified FromAddress.
    "Provider": "Log",
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "ApiKey": "",
    "FromAddress": "no-reply@example.com",
    "FromName": "Quiz Management"
  }
}
