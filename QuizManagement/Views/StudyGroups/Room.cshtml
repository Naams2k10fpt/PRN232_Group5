@model BusinessObjects.StudyGroup
@using BusinessObjects
@using QuizManagement.Services
@using System.Text.Json
@{
    ViewData["Title"] = Model.Name;
    ViewData["UsesChatHub"] = true;
    var members = ViewBag.Members as List<GroupMemberSummary> ?? new();
    var userId = (string)ViewBag.UserId;
    var role = (int)(members.FirstOrDefault(member => member.UserId == userId)?.Role ?? StudyGroupMemberRole.Member);
}
<link rel="stylesheet" href="~/css/channel-chat.css" asp-append-version="true" />
<div id="channelChat" class="channel-chat" data-group-id="@Model.Id" data-user-id="@userId" data-role="@role">
    <aside class="cc-sidebar" aria-label="Các kênh trong nhóm">
        <a class="cc-back" asp-action="Index">← Nhóm học</a>
        <div class="cc-server"><div class="cc-server-mark">@Model.Name[..1].ToUpper()</div><div><h1>@Model.Name</h1><p>@Model.Description</p></div></div>
        <div class="cc-section-heading"><span>KÊNH TRÒ CHUYỆN</span><button id="createChannel" type="button" class="cc-icon" title="Tạo kênh" aria-label="Tạo kênh" hidden="@(role < 1)">+</button></div>
        <nav id="channelList" class="cc-channels" aria-label="Danh sách kênh"></nav>
        <div class="cc-server-footer">
            @if (role >= 1) { <a asp-action="Manage" asp-route-id="@Model.Id">Quản lý nhóm ↗</a> }
            <span>@members.Count thành viên · Nhóm học tập</span>
        </div>
    </aside>
    <section class="cc-main" aria-label="Nội dung kênh chat">
        <header class="cc-header"><span class="cc-hash">#</span><div class="cc-channel-title"><h2 id="channelTitle">Đang tải kênh…</h2><p id="channelTopic"></p></div>
            <button id="editChannel" class="cc-icon" title="Sửa kênh" type="button" hidden="@(role < 1)">⚙</button>
            <button id="toggleMembers" class="cc-icon" title="Thành viên" type="button" aria-controls="chatMembers" aria-expanded="false">☷</button>
        </header>
        <div id="chatAlert" class="cc-alert" role="alert" hidden></div>
        <div id="connectionStatus" class="cc-connection" role="status">Đang kết nối…</div>
        <div class="cc-timeline-wrap">
            <div id="chatTimeline" class="cc-timeline" role="log" aria-label="Tin nhắn">
                <div class="cc-welcome"><span>#</span><h3>Chào mừng đến với nhóm!</h3><p>Chia sẻ kiến thức, đặt câu hỏi và cùng nhau học tập.</p></div>
            </div>
            <button id="newMessages" type="button" class="cc-new" hidden>↓ Tin nhắn mới</button>
        </div>
        <div class="cc-compose-area">
            <div id="composerContext" class="cc-context" hidden><span id="composerContextText"></span><button id="cancelContext" type="button" class="cc-icon" aria-label="Hủy trả lời hoặc chỉnh sửa">×</button></div>
            <div id="pendingFiles" class="cc-pending"></div>
            <form id="channelMessageForm" class="cc-composer">
                @Html.AntiForgeryToken()
                <input id="chatFiles" type="file" multiple hidden accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.csv,.zip,.docx,.xlsx,.pptx" />
                <button id="attachFile" type="button" class="cc-attach" title="Đính kèm ảnh/file" aria-label="Đính kèm ảnh/file">+</button>
                <textarea id="chatInput" rows="1" maxlength="2000" placeholder="Nhắn vào kênh…" aria-label="Nội dung tin nhắn"></textarea>
                <button id="sendMessage" type="submit" class="cc-send" aria-label="Gửi tin nhắn">Gửi ↗</button>
            </form>
            <div class="cc-compose-hint"><span>Enter để gửi · Shift + Enter để xuống dòng</span><span>3 file / tin · 5 MB / file</span></div>
        </div>
    </section>
    <aside id="chatMembers" class="cc-members" aria-label="Thành viên"><h3>THÀNH VIÊN <span id="memberCount">@members.Count</span></h3><p id="presenceStatus">Đang đồng bộ trạng thái…</p><div id="memberList"></div></aside>
</div>
<dialog id="channelEditor" class="cc-dialog">
    <form id="channelEditorForm"><h2 id="channelEditorTitle">Tạo kênh</h2>
        <label for="channelName">Tên kênh</label><input id="channelName" class="form-control" required maxlength="40" placeholder="ví dụ: bài-tập" />
        <label for="channelDescription">Chủ đề</label><input id="channelDescription" class="form-control" maxlength="200" placeholder="Kênh này dành cho nội dung gì?" />
        <p id="channelEditorError" class="text-danger small" role="alert"></p>
        <div class="cc-dialog-actions"><button id="archiveChannel" type="button" class="btn btn-outline-danger" hidden>Lưu trữ kênh</button><button id="cancelChannelEditor" type="button" class="btn btn-outline-secondary">Hủy</button><button class="btn btn-primary" type="submit">Lưu kênh</button></div>
    </form>
</dialog>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>window.channelChatMembers = @Html.Raw(JsonSerializer.Serialize(members, JsonSerializerOptions.Web));</script>
    <script src="~/js/channel-chat.js" asp-append-version="true"></script>
}
