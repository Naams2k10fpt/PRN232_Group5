@model List<QuizManagement.Services.GroupSummary>
@using BusinessObjects
@using QuizManagement.Services
@{
    ViewData["Title"] = "Nhóm học tập";
    var invitations = ViewBag.Invitations as List<GroupInvitationSummary> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Nhóm học tập</h1>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (invitations.Count > 0)
{
    <section class="card p-3 mb-4">
        <h2 class="h5">Lời mời vào nhóm</h2>
        @foreach (var invitation in invitations)
        {
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="me-auto">@invitation.GroupName · hết hạn @invitation.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                <form asp-action="RespondInvitation" asp-route-id="@invitation.GroupId" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-primary" name="accept" value="true">Chấp nhận</button>
                    <button class="btn btn-sm btn-outline-secondary" name="accept" value="false">Từ chối</button>
                </form>
            </div>
        }
    </section>
}

<form asp-action="Create" method="post" class="card p-3 mb-4">
    @Html.AntiForgeryToken()
    <h2 class="h5">Tạo nhóm mới</h2>
    <div class="row g-2">
        <div class="col-md-4"><input name="name" maxlength="200" required class="form-control" placeholder="Tên nhóm" /></div>
        <div class="col-md-5"><input name="description" maxlength="500" class="form-control" placeholder="Mô tả ngắn" /></div>
        <div class="col-md-3">
            <select name="accessMode" class="form-select mb-2" aria-label="Quyền tham gia nhóm">
                <option value="PublicOpen">Công khai · vào ngay</option>
                <option value="PublicApproval">Công khai · cần duyệt</option>
                <option value="PrivateInviteOnly">Private · chỉ được mời</option>
            </select>
            <button type="submit" class="btn btn-primary w-100">Tạo nhóm</button>
        </div>
    </div>
</form>

<div class="row g-3">
    @foreach (var group in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 p-3">
                <h2 class="h5">@group.Name</h2>
                <span class="small text-info mb-2">@(group.AccessMode switch {
                    StudyGroupAccessMode.PublicApproval => "Cần duyệt",
                    StudyGroupAccessMode.PrivateInviteOnly => "Private",
                    _ => "Công khai"
                })</span>
                <p class="text-muted mb-2">@(group.Description ?? "Chưa có mô tả")</p>
                <p class="small mb-3">@group.MemberCount thành viên · @(group.SubjectName ?? "Chung")
                    @if (group.IsMember && group.UnreadCount > 0)
                    {
                        <span class="badge bg-primary ms-1">@group.UnreadCount mới</span>
                    }
                </p>
                @if (group.IsMember)
                {
                    <a asp-action="Room" asp-route-id="@group.Id" class="btn btn-outline-primary mt-auto">Mở phòng chat</a>
                }
                else
                {
                    @if (group.HasPendingRequest)
                    {
                        <form asp-action="CancelRequest" asp-route-id="@group.Id" method="post" class="mt-auto">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary w-100">Đang chờ · hủy yêu cầu</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Join" asp-route-id="@group.Id" method="post" class="mt-auto">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary w-100">@(group.AccessMode == StudyGroupAccessMode.PublicApproval ? "Yêu cầu tham gia" : "Tham gia")</button>
                        </form>
                    }
                }
            </div>
        </div>
    }
</div>
