@using BusinessObjects
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1120" />
    <title>@ViewData["Title"] - QuizManagement</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuizManagement.styles.css" asp-append-version="true" />
    <script>
        (function() {
            var savedTheme = localStorage.getItem('quizms_theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <!-- Academic Cyber Ambient Background System -->
    <div class="quizms-ambient-bg" aria-hidden="true">
        <div class="quizms-cyber-grid"></div>
        <div class="quizms-glow-orb orb-1"></div>
        <div class="quizms-glow-orb orb-2"></div>
        <div class="quizms-glow-orb orb-3"></div>
        <canvas id="quizms-ambient-canvas" class="quizms-ambient-canvas"></canvas>
        <div class="quizms-floating-motifs">
            <span class="quizms-motif" style="top:12%; left:5%; font-size:26px; animation-duration:18s; color:rgba(124,109,248,0.22);">∫</span>
            <span class="quizms-motif" style="top:20%; right:8%; font-size:26px; animation-duration:22s; animation-delay:2s; color:rgba(34,211,238,0.22);">∑</span>
            <span class="quizms-motif" style="top:58%; left:6%; font-size:24px; animation-duration:24s; animation-delay:4s; color:rgba(124,109,248,0.20);">λ</span>
            <span class="quizms-motif" style="top:74%; right:10%; font-size:24px; animation-duration:20s; animation-delay:1s; color:rgba(52,211,153,0.20);">π</span>
            <span class="quizms-motif" style="top:35%; right:18%; font-size:22px; animation-duration:26s; animation-delay:3s; color:rgba(251,191,36,0.22);">√x</span>
            <span class="quizms-motif" style="top:84%; left:18%; font-size:24px; animation-duration:25s; animation-delay:5s; color:rgba(34,211,238,0.20);">Δ</span>
            <span class="quizms-motif" style="top:8%; left:45%; font-size:24px; animation-duration:21s; animation-delay:6s; color:rgba(167,139,250,0.18);">∞</span>
            <span class="quizms-motif" style="top:88%; right:38%; font-size:24px; animation-duration:23s; animation-delay:2.5s; color:rgba(34,211,238,0.18);">∂</span>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <partial name="_BrandLogo" view-data='@(new ViewDataDictionary(ViewData) { { "Size", 30 }, { "ShowText", true } })' />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Subjects" asp-action="Index">Môn học</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Statistics" asp-action="Index">Thống kê</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="History" asp-action="Index">Lịch sử</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="StudyGroups" asp-action="Index">Nhóm học tập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Kahoot" asp-action="Index">
                                    <i class="bi bi-controller me-1"></i>Kahoot Live
                                </a>
                            </li>
                            @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Mentor))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Statistics" asp-action="MentorStats">Thống kê nội dung</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="QuestionReports" asp-action="Index">Báo cáo lỗi</a>
                                </li>
                            }
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-semibold" asp-controller="Admin" asp-action="Index">Quản trị</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-2">
                            <button id="quizms-theme-toggle" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                                    type="button" title="Chuyển chế độ Sáng / Tối" style="width: 36px; height: 36px; padding: 0;">
                                <span id="theme-toggle-icon" style="font-size: 15px;">🌙</span>
                            </button>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="nav-avatar">
                                        @(User.Identity.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "U")
                                    </span>
                                    <span class="d-none d-md-inline">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                            Hồ sơ
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Profile" asp-action="ChangePassword">
                                            Đổi mật khẩu
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                            <button type="submit" class="dropdown-item" style="color:var(--danger)!important;">
                                                Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item ms-1">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register"
                                   style="padding:0.35rem 0.85rem;">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container page-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <span>&copy; 2026 QuizManagement</span>
            <span class="mx-2" style="opacity:.3">·</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color:var(--text-dim);">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/gamification.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true && ViewData["UsesChatHub"] is not true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script>
            (() => {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/chat').withAutomaticReconnect().build();
                const connect = async () => {
                    try { await connection.start(); }
                    catch { window.setTimeout(connect, 5000); }
                };
                connection.onclose(() => window.setTimeout(connect, 5000));
                connect();
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (function() {
            var canvas = document.getElementById('quizms-ambient-canvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            if (!ctx) return;

            var width = 0, height = 0;
            var particles = [];
            var particleCount = 125;
            var mouse = { x: -1000, y: -1000, radius: 140 };

            function resize() {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize, { passive: true });
            resize();

            window.addEventListener('mousemove', function(e) {
                mouse.x = e.clientX;
                mouse.y = e.clientY;
            }, { passive: true });

            window.addEventListener('mouseleave', function() {
                mouse.x = -1000;
                mouse.y = -1000;
            }, { passive: true });

            for (var i = 0; i < particleCount; i++) {
                var isMinor = i >= 45; // Minor particles are smaller, subtler micro-dots
                particles.push({
                    x: Math.random() * (width || window.innerWidth || 1200),
                    y: Math.random() * (height || window.innerHeight || 800),
                    vx: (Math.random() - 0.5) * (isMinor ? 0.25 : 0.35),
                    vy: (Math.random() - 0.5) * (isMinor ? 0.25 : 0.35),
                    radius: isMinor ? (Math.random() * 0.9 + 0.45) : (Math.random() * 1.5 + 0.8),
                    alpha: isMinor ? (Math.random() * 0.35 + 0.25) : 0.65,
                    color: i % 4 === 0 ? 'rgba(124, 109, 248, ' : (i % 4 === 1 ? 'rgba(34, 211, 238, ' : (i % 4 === 2 ? 'rgba(251, 191, 36, ' : 'rgba(167, 139, 250, ')),
                    connectable: !isMinor
                });
            }

            var running = true;
            document.addEventListener('visibilitychange', function() {
                running = !document.hidden;
                if (running) requestAnimationFrame(loop);
            });

            function loop() {
                if (!running) return;
                ctx.clearRect(0, 0, width, height);

                // Draw constellation neural links for major connectable nodes
                for (var i = 0; i < particles.length; i++) {
                    var p1 = particles[i];
                    if (!p1.connectable) continue;

                    for (var j = i + 1; j < particles.length; j++) {
                        var p2 = particles[j];
                        if (!p2.connectable) continue;

                        var dx = p1.x - p2.x;
                        var dy = p1.y - p2.y;
                        var dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 110) {
                            var alpha = (1 - dist / 110) * 0.16;
                            ctx.strokeStyle = 'rgba(124, 109, 248, ' + alpha + ')';
                            ctx.lineWidth = 0.8;
                            ctx.beginPath();
                            ctx.moveTo(p1.x, p1.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.stroke();
                        }
                    }

                    // Mouse interactive link
                    var mdx = p1.x - mouse.x;
                    var mdy = p1.y - mouse.y;
                    var mdist = Math.sqrt(mdx * mdx + mdy * mdy);
                    if (mdist < mouse.radius) {
                        var mAlpha = (1 - mdist / mouse.radius) * 0.28;
                        ctx.strokeStyle = 'rgba(34, 211, 238, ' + mAlpha + ')';
                        ctx.lineWidth = 1;
                        ctx.beginPath();
                        ctx.moveTo(p1.x, p1.y);
                        ctx.lineTo(mouse.x, mouse.y);
                        ctx.stroke();
                    }
                }

                // Update and render all particles (primary nodes + abundant micro dots)
                for (var k = 0; k < particles.length; k++) {
                    var p = particles[k];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = width;
                    else if (p.x > width) p.x = 0;
                    if (p.y < 0) p.y = height;
                    else if (p.y > height) p.y = 0;

                    ctx.fillStyle = p.color + (p.alpha || 0.65) + ')';
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fill();
                }

                requestAnimationFrame(loop);
            }
            requestAnimationFrame(loop);
        })();

        // Theme Mode Toggle Controller
        (function() {
            var toggleBtn = document.getElementById('quizms-theme-toggle');
            var icon = document.getElementById('theme-toggle-icon');

            function updateIcon(theme) {
                if (icon) {
                    icon.textContent = theme === 'light' ? '☀️' : '🌙';
                }
                if (toggleBtn) {
                    toggleBtn.title = theme === 'light' ? 'Chuyển sang chế độ Tối (Dark Mode)' : 'Chuyển sang chế độ Sáng (Light Mode)';
                }
            }

            var currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'dark';
            updateIcon(currentTheme);

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    var cur = document.documentElement.getAttribute('data-bs-theme') || 'dark';
                    var next = cur === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-bs-theme', next);
                    localStorage.setItem('quizms_theme', next);
                    updateIcon(next);
                });
            }
        })();
    </script>

    <!-- Global Custom Modal System (replaces raw browser alert & confirm) -->
    <div class="modal fade quizms-modal" id="quizms-global-modal" tabindex="-1" aria-labelledby="quizms-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-3">
                        <div id="quizms-modal-icon-badge" class="quizms-modal-icon-badge mb-0">
                            <span id="quizms-modal-icon">⚠️</span>
                        </div>
                        <h5 class="modal-title fw-bold fs-5 mb-0" id="quizms-modal-title">Xác nhận</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div id="quizms-modal-message" class="fs-6" style="color:var(--text-muted); line-height:1.6;">
                        Nội dung thông báo
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="quizms-modal-cancel-btn" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="button" class="btn btn-sm btn-primary px-4 fw-semibold" id="quizms-modal-confirm-btn">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Global Modal Controller Script -->
    <script>
        (function() {
            var modalEl = document.getElementById('quizms-global-modal');
            var iconEl = document.getElementById('quizms-modal-icon');
            var titleEl = document.getElementById('quizms-modal-title');
            var messageEl = document.getElementById('quizms-modal-message');
            var confirmBtn = document.getElementById('quizms-modal-confirm-btn');
            var cancelBtn = document.getElementById('quizms-modal-cancel-btn');

            window.QuizModal = {
                confirm: function(options) {
                    options = options || {};
                    return new Promise(function(resolve) {
                        if (!modalEl || !window.bootstrap) {
                            resolve(window.confirm(options.message || 'Bạn có chắc chắn?'));
                            return;
                        }
                        iconEl.textContent = options.icon || '⚠️';
                        titleEl.textContent = options.title || 'Xác nhận thao tác';
                        messageEl.innerHTML = options.message || 'Bạn có chắc muốn thực hiện thao tác này?';

                        confirmBtn.className = 'btn btn-sm px-4 fw-semibold ' + (options.confirmClass || 'btn-primary');
                        confirmBtn.textContent = options.confirmText || 'Xác nhận';
                        cancelBtn.textContent = options.cancelText || 'Hủy bỏ';
                        cancelBtn.style.display = '';

                        var bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        var isConfirmed = false;

                        function handleConfirm() {
                            isConfirmed = true;
                            bsModal.hide();
                        }

                        confirmBtn.onclick = handleConfirm;

                        function handleHidden() {
                            modalEl.removeEventListener('hidden.bs.modal', handleHidden);
                            confirmBtn.onclick = null;
                            resolve(isConfirmed);
                        }

                        modalEl.addEventListener('hidden.bs.modal', handleHidden);
                        bsModal.show();
                    });
                },
                alert: function(options) {
                    var msg = typeof options === 'string' ? options : (options.message || '');
                    var title = (typeof options === 'object' && options.title) ? options.title : 'Thông báo';
                    var icon = (typeof options === 'object' && options.icon) ? options.icon : 'ℹ️';
                    var btnText = (typeof options === 'object' && options.btnText) ? options.btnText : 'Đã hiểu';

                    return new Promise(function(resolve) {
                        if (!modalEl || !window.bootstrap) {
                            window.alert(msg);
                            resolve();
                            return;
                        }
                        iconEl.textContent = icon;
                        titleEl.textContent = title;
                        messageEl.innerHTML = msg;

                        confirmBtn.className = 'btn btn-sm btn-primary px-4 fw-semibold';
                        confirmBtn.textContent = btnText;
                        cancelBtn.style.display = 'none';

                        var bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);

                        function handleHidden() {
                            cancelBtn.style.display = '';
                            modalEl.removeEventListener('hidden.bs.modal', handleHidden);
                            confirmBtn.onclick = null;
                            resolve();
                        }

                        confirmBtn.onclick = function() {
                            bsModal.hide();
                        };

                        modalEl.addEventListener('hidden.bs.modal', handleHidden);
                        bsModal.show();
                    });
                },
                confirmAction: function(element, event, message, title, confirmClass, confirmText) {
                    if (element._isActionConfirmed) {
                        element._isActionConfirmed = false;
                        return true;
                    }
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    this.confirm({
                        title: title || 'Xác nhận thao tác',
                        message: message,
                        confirmClass: confirmClass || 'btn-danger',
                        confirmText: confirmText || 'Đồng ý',
                        icon: '⚠️'
                    }).then(function(confirmed) {
                        if (confirmed) {
                            element._isActionConfirmed = true;
                            if (element.form) {
                                element.form.requestSubmit ? element.form.requestSubmit(element) : element.form.submit();
                            } else if (element.tagName === 'A' && element.href) {
                                window.location.href = element.href;
                            } else {
                                element.click();
                            }
                        }
                    });
                    return false;
                }
            };

            // Unobtrusive replacement of window.alert
            var nativeAlert = window.alert;
            window.alert = function(msg) {
                if (modalEl && window.bootstrap) {
                    window.QuizModal.alert(msg);
                } else {
                    nativeAlert(msg);
                }
            };
        })();
    </script>
</body>
</html>
