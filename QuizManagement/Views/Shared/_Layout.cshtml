                            <li class="nav-item">
                                <a class="nav-link @(currentCtrl.Equals("Subjects", StringComparison.OrdinalIgnoreCase) || currentCtrl.Equals("Decks", StringComparison.OrdinalIgnoreCase) || currentCtrl.Equals("Questions", StringComparison.OrdinalIgnoreCase) || currentCtrl.Equals("QuestionImport", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Subjects" asp-action="Index">Môn học</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentCtrl.Equals("Statistics", StringComparison.OrdinalIgnoreCase) && !currentAct.Equals("MentorStats", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Statistics" asp-action="Index">Thống kê</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentCtrl.Equals("History", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="History" asp-action="Index">Lịch sử</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentCtrl.Equals("StudyGroups", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="StudyGroups" asp-action="Index">Nhóm học tập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold d-flex align-items-center @(currentCtrl.Equals("Kahoot", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Kahoot" asp-action="Index">
                                    <span class="iconify me-1" data-icon="lucide:gamepad-2"></span>Kahoot Live
                                </a>
                            </li>
                            @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Mentor))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentCtrl.Equals("Statistics", StringComparison.OrdinalIgnoreCase) && currentAct.Equals("MentorStats", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Statistics" asp-action="MentorStats">Thống kê nội dung</a>
