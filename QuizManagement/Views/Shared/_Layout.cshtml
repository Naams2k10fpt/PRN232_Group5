                            <a class="nav-link @(currentCtrl.Equals("Home", StringComparison.OrdinalIgnoreCase) && currentAct.Equals("Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
