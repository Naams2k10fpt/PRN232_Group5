    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/gamification.js" asp-append-version="true"></script>
    <script>
        (function() {
            var screen = document.getElementById('quizms-opening-screen');
            var progressBar = document.getElementById('quizms-opening-progress');
            var statusText = document.getElementById('quizms-opening-status-text');

            if (!screen) return;

            var urlParams = new URLSearchParams(window.location.search);
            var forceIntro = urlParams.get('intro') === '1';
            var hasSeen = sessionStorage.getItem('quizms_splash_seen');

            if (hasSeen && !forceIntro) {
                screen.remove();
                return;
            }

            var progress = 0;
            var interval = setInterval(function() {
                progress += 18;
                if (progressBar) progressBar.style.width = Math.min(progress, 90) + '%';
                if (progress >= 35 && statusText) statusText.textContent = 'Đồng bộ tài nguyên học tập…';
                if (progress >= 75 && statusText) statusText.textContent = 'Sẵn sàng trải nghiệm!';
            }, 100);

            function dismissIntro() {
                clearInterval(interval);
                if (progressBar) progressBar.style.width = '100%';
                setTimeout(function() {
                    screen.classList.add('quizms-opening-hidden');
                    sessionStorage.setItem('quizms_splash_seen', 'true');
                    setTimeout(function() {
                        if (screen.parentNode) screen.parentNode.removeChild(screen);
                    }, 550);
                }, 220);
            }

            setTimeout(dismissIntro, 1300);
            screen.addEventListener('click', dismissIntro);

            window.replayIntro = function() {
                sessionStorage.removeItem('quizms_splash_seen');
                window.location.href = window.location.pathname + '?intro=1';
            };
        })();
    </script>
    @if (User.Identity?.IsAuthenticated == true && ViewData["UsesChatHub"] is not true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script>
            (() => {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/chat').withAutomaticReconnect().build();
                const connect = async () => {
                    try { await connection.start(); }
                    catch { window.setTimeout(connect, 5000); }
                };
                connection.onclose(() => window.setTimeout(connect, 5000));
                connect();
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (function() {
            var canvas = document.getElementById('quizms-ambient-canvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            if (!ctx) return;

            var width = 0, height = 0;
            var particles = [];
            var particleCount = 380; // Abundant celestial drifting micro-dots
            var mouse = { x: -1000, y: -1000, radius: 150 };

            function resize() {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize, { passive: true });
            resize();

            window.addEventListener('mousemove', function(e) {
                mouse.x = e.clientX;
                mouse.y = e.clientY;
            }, { passive: true });

            window.addEventListener('mouseleave', function() {
                mouse.x = -1000;
                mouse.y = -1000;
            }, { passive: true });

            for (var i = 0; i < particleCount; i++) {
                var isMinor = i >= 45; // Only 45 primary constellation nodes calculate distance O(K^2)
                particles.push({
                    x: Math.random() * (width || window.innerWidth || 1200),
                    y: Math.random() * (height || window.innerHeight || 800),
                    vx: (Math.random() - 0.5) * (isMinor ? 0.28 : 0.38),
                    vy: (Math.random() - 0.5) * (isMinor ? 0.28 : 0.38),
                    radius: isMinor ? (Math.random() * 0.95 + 0.35) : (Math.random() * 1.5 + 0.9),
                    baseAlpha: isMinor ? (Math.random() * 0.35 + 0.15) : 0.65,
                    twinkleSpeed: Math.random() * 0.03 + 0.015,
                    twinklePhase: Math.random() * Math.PI * 2,
                    color: i % 4 === 0 ? 'rgba(102, 58, 243, ' : (i % 4 === 1 ? 'rgba(56, 189, 248, ' : (i % 4 === 2 ? 'rgba(251, 191, 36, ' : 'rgba(167, 139, 250, ')),
                    connectable: !isMinor
                });
            }

            var running = true;
            document.addEventListener('visibilitychange', function() {
                running = !document.hidden;
                if (running) requestAnimationFrame(loop);
            });

            function loop() {
                if (!running) return;
                ctx.clearRect(0, 0, width, height);

                // Draw constellation neural links for major connectable nodes
                for (var i = 0; i < particles.length; i++) {
                    var p1 = particles[i];
                    if (!p1.connectable) continue;

                    for (var j = i + 1; j < particles.length; j++) {
                        var p2 = particles[j];
                        if (!p2.connectable) continue;

                        var dx = p1.x - p2.x;
                        var dy = p1.y - p2.y;
                        var dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 110) {
                            var alpha = (1 - dist / 110) * 0.16;
                            ctx.strokeStyle = 'rgba(102, 58, 243, ' + alpha + ')';
                            ctx.lineWidth = 0.8;
                            ctx.beginPath();
                            ctx.moveTo(p1.x, p1.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.stroke();
                        }
                    }

                    // Mouse interactive link
                    var mdx = p1.x - mouse.x;
                    var mdy = p1.y - mouse.y;
                    var mdist = Math.sqrt(mdx * mdx + mdy * mdy);
                    if (mdist < mouse.radius) {
                        var mAlpha = (1 - mdist / mouse.radius) * 0.28;
                        ctx.strokeStyle = 'rgba(56, 189, 248, ' + mAlpha + ')';
                        ctx.lineWidth = 1;
                        ctx.beginPath();
                        ctx.moveTo(p1.x, p1.y);
                        ctx.lineTo(mouse.x, mouse.y);
                        ctx.stroke();
                    }
                }

                // Update and render all particles (primary nodes + abundant micro dots with organic twinkle)
                for (var k = 0; k < particles.length; k++) {
                    var p = particles[k];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = width;
                    else if (p.x > width) p.x = 0;
                    if (p.y < 0) p.y = height;
                    else if (p.y > height) p.y = 0;

                    p.twinklePhase += p.twinkleSpeed;
                    var currentAlpha = p.baseAlpha + Math.sin(p.twinklePhase) * 0.12;
                    if (currentAlpha < 0.05) currentAlpha = 0.05;

                    ctx.fillStyle = p.color + currentAlpha + ')';
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fill();
                }

                requestAnimationFrame(loop);
            }
            requestAnimationFrame(loop);
        })();

        // Theme Mode Toggle Controller
        (function() {
            var toggleBtn = document.getElementById('quizms-theme-toggle');
            var icon = document.getElementById('theme-toggle-icon');

            function updateIcon(theme) {
                if (icon) {
                    icon.innerHTML = theme === 'light'
                        ? '<span class="iconify" data-icon="radix-icons:sun" style="font-size:16px;"></span>'
                        : '<span class="iconify" data-icon="radix-icons:moon" style="font-size:16px;"></span>';
                }
                if (toggleBtn) {
                    toggleBtn.title = theme === 'light' ? 'Chuyển sang chế độ Tối (Dark Mode)' : 'Chuyển sang chế độ Sáng (Light Mode)';
                }
            }

            var currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'dark';
            updateIcon(currentTheme);

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    var cur = document.documentElement.getAttribute('data-bs-theme') || 'dark';
                    var next = cur === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-bs-theme', next);
                    localStorage.setItem('quizms_theme', next);
                    updateIcon(next);
                });
            }
        })();
    </script>

    <!-- Global Custom Modal System (replaces raw browser alert & confirm) -->
    <div class="modal fade quizms-modal" id="quizms-global-modal" tabindex="-1" aria-labelledby="quizms-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-3">
                        <div id="quizms-modal-icon-badge" class="quizms-modal-icon-badge mb-0">
                            <span id="quizms-modal-icon"><span class="iconify fs-3 text-warning" data-icon="radix-icons:exclamation-triangle"></span></span>
                        </div>
                        <h5 class="modal-title fw-bold fs-5 mb-0" id="quizms-modal-title">Xác nhận</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div id="quizms-modal-message" class="fs-6" style="color:var(--text-muted); line-height:1.6;">
                        Nội dung thông báo
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="quizms-modal-cancel-btn" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="button" class="btn btn-sm btn-primary px-4 fw-semibold" id="quizms-modal-confirm-btn">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Global Modal Controller Script -->
    <script>
        (function() {
            var modalEl = document.getElementById('quizms-global-modal');
            var iconEl = document.getElementById('quizms-modal-icon');
            var titleEl = document.getElementById('quizms-modal-title');
            var messageEl = document.getElementById('quizms-modal-message');
            var confirmBtn = document.getElementById('quizms-modal-confirm-btn');
            var cancelBtn = document.getElementById('quizms-modal-cancel-btn');

            function getRadixIconHtml(iconType, isAlert) {
                if (typeof iconType === 'string' && iconType.indexOf('<') !== -1) return iconType;
                if (iconType === 'success' || iconType === '✅') return '<span class="iconify fs-3 text-success" data-icon="radix-icons:check-circled"></span>';
                if (iconType === 'danger' || iconType === 'error' || iconType === '❌') return '<span class="iconify fs-3 text-danger" data-icon="radix-icons:cross-circled"></span>';
                if (iconType === 'info' || iconType === 'ℹ️' || isAlert) return '<span class="iconify fs-3 text-info" data-icon="radix-icons:info-circled"></span>';
                return '<span class="iconify fs-3 text-warning" data-icon="radix-icons:exclamation-triangle"></span>';
            }

            window.QuizModal = {
                confirm: function(options) {
                    options = options || {};
                    return new Promise(function(resolve) {
                        if (!modalEl || !window.bootstrap) {
                            resolve(window.confirm(options.message || 'Bạn có chắc chắn?'));
                            return;
                        }
                        iconEl.innerHTML = getRadixIconHtml(options.icon, false);
                        titleEl.textContent = options.title || 'Xác nhận thao tác';
                        messageEl.innerHTML = options.message || 'Bạn có chắc muốn thực hiện thao tác này?';

                        confirmBtn.className = 'btn btn-sm px-4 fw-semibold ' + (options.confirmClass || 'btn-primary');
                        confirmBtn.textContent = options.confirmText || 'Xác nhận';
                        cancelBtn.textContent = options.cancelText || 'Hủy bỏ';
                        cancelBtn.style.display = '';

                        var bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        var isConfirmed = false;

                        function handleConfirm() {
                            isConfirmed = true;
                            bsModal.hide();
                        }

                        confirmBtn.onclick = handleConfirm;

                        function handleHidden() {
                            modalEl.removeEventListener('hidden.bs.modal', handleHidden);
                            confirmBtn.onclick = null;
                            resolve(isConfirmed);
                        }

                        modalEl.addEventListener('hidden.bs.modal', handleHidden);
                        bsModal.show();
                    });
                },
                alert: function(options) {
                    var msg = typeof options === 'string' ? options : (options.message || '');
                    var title = (typeof options === 'object' && options.title) ? options.title : 'Thông báo';
                    var icon = (typeof options === 'object' && options.icon) ? options.icon : 'info';
                    var btnText = (typeof options === 'object' && options.btnText) ? options.btnText : 'Đã hiểu';

                    return new Promise(function(resolve) {
                        if (!modalEl || !window.bootstrap) {
                            window.alert(msg);
                            resolve();
                            return;
                        }
                        iconEl.innerHTML = getRadixIconHtml(icon, true);
                        titleEl.textContent = title;
                        messageEl.innerHTML = msg;

                        confirmBtn.className = 'btn btn-sm btn-primary px-4 fw-semibold';
                        confirmBtn.textContent = btnText;
                        cancelBtn.style.display = 'none';

                        var bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);

                        function handleHidden() {
                            cancelBtn.style.display = '';
                            modalEl.removeEventListener('hidden.bs.modal', handleHidden);
                            confirmBtn.onclick = null;
                            resolve();
                        }

                        confirmBtn.onclick = function() {
                            bsModal.hide();
                        };

                        modalEl.addEventListener('hidden.bs.modal', handleHidden);
                        bsModal.show();
                    });
                },
                confirmAction: function(element, event, message, title, confirmClass, confirmText) {
                    if (element._isActionConfirmed) {
                        element._isActionConfirmed = false;
                        return true;
                    }
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    this.confirm({
                        title: title || 'Xác nhận thao tác',
                        message: message,
                        confirmClass: confirmClass || 'btn-danger',
                        confirmText: confirmText || 'Đồng ý',
                        icon: '⚠️'
                    }).then(function(confirmed) {
                        if (confirmed) {
                            element._isActionConfirmed = true;
                            if (element.form) {
                                element.form.requestSubmit ? element.form.requestSubmit(element) : element.form.submit();
                            } else if (element.tagName === 'A' && element.href) {
                                window.location.href = element.href;
                            } else {
                                element.click();
                            }
                        }
                    });
                    return false;
                }
            };

            // Unobtrusive replacement of window.alert
            var nativeAlert = window.alert;
            window.alert = function(msg) {
                if (modalEl && window.bootstrap) {
                    window.QuizModal.alert(msg);
                } else {
                    nativeAlert(msg);
                }
            };
        })();
    </script>
</body>
</html>
