@*
    QuizMS Cyber-Academic Brand Emblem
    Replaces the crude plain "Q" text block with a high-fidelity vector emblem
*@
@{
    int size = ViewData["Size"] as int? ?? 58;
    bool showText = ViewData["ShowText"] as bool? ?? false;
}

<div class="quizms-brand-wrapper d-inline-flex align-items-center gap-2" style="overflow: visible;">
    <div class="quizms-brand-icon-box position-relative" style="width: @(size)px; height: @(size)px; flex-shrink: 0; overflow: visible;">
        <!-- Expansive Diffuse Ambient Glow Halo (Unconstrained / Smooth / Never clipped) -->
        <div class="quizms-emblem-ambient-glow" aria-hidden="true"></div>
        <svg class="quizms-brand-emblem" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%; height:100%; display:block; position:relative; z-index:1; overflow:visible;">
            <defs>
                <linearGradient id="quizms-brand-primary" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#663af3" />
                    <stop offset="100%" stop-color="#38bdf8" />
                </linearGradient>
            </defs>

            <!-- Minimalist Monogram Container (AuthKit / Radix Style) -->
            <rect x="4" y="4" width="56" height="56" rx="16" fill="var(--bg-elevated, #161c28)" stroke="rgba(186, 215, 247, 0.18)" stroke-width="1.5" />

            <!-- Clean Geometric Q Monogram Ring -->
            <circle cx="32" cy="30" r="14" stroke="url(#quizms-brand-primary)" stroke-width="4.5" fill="none" stroke-linecap="round" />

            <!-- Clean Geometric Q Tail (45-degree angled stroke) -->
            <path d="M38 36 L46 44" stroke="url(#quizms-brand-primary)" stroke-width="4.5" stroke-linecap="round" />

            <!-- Subtle Inner Focus Dot -->
            <circle cx="32" cy="30" r="2.5" fill="#38bdf8" />
        </svg>
    </div>
    @if (showText)
    {
        <span class="quizms-brand-text brand-text fw-bold fs-5 tracking-tight">QuizMS</span>
    }
</div>
