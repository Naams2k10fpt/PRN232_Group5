@*
    QuizMS Cyber-Academic Brand Emblem
    Replaces the crude plain "Q" text block with a high-fidelity vector emblem
*@
@{
    int size = ViewData["Size"] as int? ?? 58;
    bool showText = ViewData["ShowText"] as bool? ?? false;
}

<div class="quizms-brand-wrapper d-inline-flex align-items-center gap-2">
    <div class="quizms-brand-icon-box" style="width: @(size)px; height: @(size)px; flex-shrink: 0;">
        <svg class="quizms-brand-emblem" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%; height:100%; display:block;">
            <defs>
                <linearGradient id="quizms-glow-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#7C6DF8" />
                    <stop offset="50%" stop-color="#22D3EE" />
                    <stop offset="100%" stop-color="#FBBF24" />
                </linearGradient>
                <linearGradient id="quizms-core-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#818CF8" />
                    <stop offset="100%" stop-color="#22D3EE" />
                </linearGradient>
                <radialGradient id="quizms-orb-light" cx="35%" cy="30%" r="70%">
                    <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.35" />
                    <stop offset="60%" stop-color="#7C6DF8" stop-opacity="0.1" />
                    <stop offset="100%" stop-color="#0B1120" stop-opacity="0" />
                </radialGradient>
                <filter id="quizms-drop-glow" x="-25%" y="-25%" width="150%" height="150%">
                    <feGaussianBlur stdDeviation="3" result="blur" />
                    <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
            </defs>

            <!-- Ambient Glow Aura -->
            <rect x="7" y="7" width="50" height="50" rx="17" fill="url(#quizms-glow-grad)" opacity="0.32" filter="url(#quizms-drop-glow)" />

            <!-- Faceted Cyber Squircle Container -->
            <rect x="3.5" y="3.5" width="57" height="57" rx="18" fill="#111827" stroke="url(#quizms-glow-grad)" stroke-width="1.75" />
            <rect x="3.5" y="3.5" width="57" height="57" rx="18" fill="url(#quizms-orb-light)" />

            <!-- Stylized Dynamic Orbit (Knowledge Ring forming futuristic Q) -->
            <path d="M32 14 C41.94 14 50 22.06 50 32 C50 36.4 48.43 40.45 45.8 43.55 L48.8 50.2 L41.9 47.7 C38.98 49.18 35.62 50 32 50 C22.06 50 14 41.94 14 32 C14 22.06 22.06 14 32 14 Z"
                  stroke="url(#quizms-core-grad)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.95" />

            <!-- Academic Intellect Spark at Center (✦) -->
            <path d="M32 20.5 C32 25.5 34 27.5 39 27.5 C34 27.5 32 29.5 32 34.5 C32 29.5 30 27.5 25 27.5 C30 27.5 32 25.5 32 20.5 Z"
                  fill="url(#quizms-glow-grad)" />

            <!-- Golden Mastery Energy Node (Ascending Ray Node) -->
            <circle cx="45.5" cy="46.5" r="4" fill="#FBBF24" />
            <circle cx="45.5" cy="46.5" r="2" fill="#FFFFFF" />

            <!-- Subtle Constellation Satellite Node -->
            <circle cx="21" cy="22.5" r="1.5" fill="#22D3EE" opacity="0.85" />
        </svg>
    </div>
    @if (showText)
    {
        <span class="quizms-brand-text brand-text fw-bold fs-5 tracking-tight">QuizMS</span>
    }
</div>
