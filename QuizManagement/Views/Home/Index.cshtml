@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var canManageContent = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Mentor);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4" style="animation: pageFadeIn .4s ease both;">
    <div>
        <h1 class="h3 fw-bold mb-1">Bảng điều khiển học tập</h1>
        <p class="mb-0 text-muted">Xin chào, <strong class="text-body">@User.Identity?.Name</strong>! Tiếp tục hành trình học tập hôm nay nào.</p>
    </div>
    
    <!-- Gamification Streak Flame Pill -->
    <div class="quizms-streak-pill d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill">
        <span class="iconify quizms-flame-icon" data-icon="lucide:flame" style="font-size: 1.25rem;"></span>
        <div>
            <div class="fw-bold" style="font-size:0.85rem; line-height:1.2;">Chuỗi 5 ngày học liên tục</div>
            <div class="small text-muted" style="font-size:0.72rem;">Đạt mục tiêu tuần 85%</div>
        </div>
    </div>
</div>

<!-- Bento Grid: Main Feature Hub -->
<div class="row g-3 mb-4">
    <!-- Bento 1: Kahoot Live Hero (Lớn) -->
    <div class="col-lg-6">
        <div class="bento-card bento-card--kahoot h-100 p-4 rounded-4 position-relative overflow-hidden d-flex flex-column justify-content-between">
            <div class="position-relative z-1">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge rounded-pill d-inline-flex align-items-center gap-1" style="background:rgba(34, 197, 94, 0.2); color:#4ade80; border:1px solid rgba(34, 197, 94, 0.3); font-size:0.75rem;">
                        <span class="pulse-dot"></span> Đấu trường trực tuyến
                    </span>
                    <div id="lottie-kahoot-trophy" style="width: 52px; height: 52px; filter: drop-shadow(0 4px 10px rgba(245, 158, 11, 0.35));"></div>
                </div>
                <h3 class="h5 fw-bold mb-2">Kahoot Live Arena</h3>
                <p class="text-muted small mb-3">Tạo phòng thi đấu thời gian thực hoặc nhập mã PIN từ thiết bị bất kỳ để tham gia so tài cùng các bạn học.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap position-relative z-1">
                <a asp-controller="Kahoot" asp-action="Index" class="btn btn-sm btn-primary px-3 rounded-pill fw-semibold">
                    Vào phòng Kahoot
                </a>
                <a asp-controller="Kahoot" asp-action="Host" class="btn btn-sm btn-outline-secondary px-3 rounded-pill">
                    Tạo phòng mới
                </a>
            </div>
        </div>
    </div>

    <!-- Bento 2: Flashcards SRS -->
    <div class="col-md-6 col-lg-3">
        <div class="bento-card h-100 p-4 rounded-4 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge rounded-pill bg-info bg-opacity-10 text-info border border-info border-opacity-25 small" style="font-size:0.72rem;">
                        Ghi nhớ thông minh
                    </span>
                    <span class="iconify fs-3 text-info" data-icon="radix-icons:layers"></span>
                </div>
                <h4 class="h6 fw-bold mb-2">Thẻ Flashcard</h4>
                <p class="text-muted small mb-3">Ôn tập ngắt quãng theo phương pháp ghi nhớ chủ động giúp nhớ kiến thức lâu hơn.</p>
            </div>
            <a asp-controller="Subjects" asp-action="Index" class="btn btn-sm btn-outline-info rounded-pill w-100">
                Ôn thẻ hôm nay
            </a>
        </div>
    </div>

    <!-- Bento 3: Study Groups Chat -->
    <div class="col-md-6 col-lg-3">
        <div class="bento-card h-100 p-4 rounded-4 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 small" style="font-size:0.72rem;">
                        Thảo luận trực tuyến
                    </span>
                    <span class="iconify fs-3 text-warning" data-icon="radix-icons:chat-bubble"></span>
                </div>
                <h4 class="h6 fw-bold mb-2">Nhóm học tập</h4>
                <p class="text-muted small mb-3">Trao đổi thắc mắc, chia sẻ đề thi và thảo luận trực tiếp với giảng viên & bạn bè.</p>
            </div>
            <a asp-controller="StudyGroups" asp-action="Index" class="btn btn-sm btn-outline-warning rounded-pill w-100">
                Phòng thảo luận
            </a>
        </div>
    </div>
</div>

<div class="row g-3 mb-5">
    <div class="col-sm-4">
        <div class="stat-card stat-card--purple">
            <div class="stat-card__label">Bài đã làm</div>
            <div class="stat-card__value">@Model.TotalQuizzesTaken</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card stat-card--cyan">
            <div class="stat-card__label">Điểm trung bình</div>
            <div class="stat-card__value">
                @if (Model.TotalQuizzesTaken > 0)
                {
                    @Model.AveragePercentage.ToString("0.#")<text>%</text>
                }
                else
                {
                    <text>—</text>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card stat-card--green">
            <div class="stat-card__label">Lần làm gần nhất</div>
            <div class="stat-card__value">
                @if (Model.LastQuizDate.HasValue)
                {
                    @VietnamTime.FromUtc(Model.LastQuizDate.Value).ToString("dd/MM HH:mm")
                }
                else
                {
                    <text>—</text>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Bài quiz gần đây</span>
                @if (Model.RecentHistories.Any())
                {
                    <a asp-controller="History" asp-action="Index" class="btn btn-sm btn-outline-secondary">Xem tất cả</a>
                }
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentHistories.Any())
                {
                    <div class="p-4" style="color:var(--text-muted);">
                        Bạn chưa làm bài quiz nào. Hãy chọn một bộ đề để bắt đầu!
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Bộ đề</th>
                                    <th class="text-center">Điểm</th>
                                    <th>Ngày</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.RecentHistories)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@h.Deck.Name</div>
                                            <small style="color:var(--text-muted);">@h.Deck.Subject.Name</small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(h.Percentage >= 50 ? "bg-success" : "bg-danger")">
                                                @h.Score.ToString("0.##")/10
                                            </span>
                                        </td>
                                        <td>
                                            <small style="color:var(--text-muted);">@VietnamTime.FromUtc(h.CreatedAt).ToString("dd/MM HH:mm")</small>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="History" asp-action="Details" asp-route-id="@h.Id"
                                               class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Học liệu</span>
                <a asp-controller="Subjects" asp-action="Index" class="btn btn-sm btn-outline-secondary">Khám phá</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Subjects.Any())
                {
                    <div class="p-4" style="color:var(--text-muted);">
                        Chưa có môn học nào.
                        @if (canManageContent)
                        {
                            <a asp-controller="Subjects" asp-action="Create" style="color:var(--accent);">Tạo mới</a><text>.</text>
                        }
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var subject in Model.Subjects)
                        {
                            <a asp-controller="Decks" asp-action="Index" asp-route-subjectId="@subject.Id"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>@subject.Name</span>
                                <span style="color:var(--text-dim);font-size:.75rem;">→</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var trophyContainer = document.getElementById('lottie-kahoot-trophy');
            if (trophyContainer && window.lottie) {
                window.lottie.loadAnimation({
                    container: trophyContainer,
                    renderer: 'svg',
                    loop: true,
                    autoplay: true,
                    path: '/assets/lottie/trophy.json'
                });
            }
        })();
    </script>
}
