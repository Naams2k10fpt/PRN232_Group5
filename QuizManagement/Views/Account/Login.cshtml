@model QuizManagement.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-showcase-container">
        <div class="auth-split-grid">
            
            <!-- Left Side: Interactive Auth Form -->
            <div class="auth-form-column">
                <div class="auth-brand text-start mb-3">
                    <div class="auth-brand-logo mb-2">
                        <partial name="_BrandLogo" view-data='@(new ViewDataDictionary(ViewData) { { "Size", 52 }, { "ShowText", true } })' />
                    </div>
                    <h1 class="h3 fw-bold mb-1">Chào mừng trở lại</h1>
                    <p class="text-muted small">Đăng nhập tài khoản QuizMS của bạn để tiếp tục học tập</p>
                </div>

                <div class="auth-card">
                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success mb-3 py-2 small">@successMessage</div>
                    }
                    @if (TempData["ErrorMessage"] is string errorMessage)
                    {
                        <div class="alert alert-danger mb-3 py-2 small">@errorMessage</div>
                    }

                    <form asp-action="Login" method="post" id="loginForm">
                        <input asp-for="ReturnUrl" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold">Email tài khoản</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted">
                                    <span class="iconify" data-icon="radix-icons:envelope-closed"></span>
                                </span>
                                <input asp-for="Email" id="inputEmail" class="form-control border-start-0 ps-0" autocomplete="email" placeholder="name@quizms.com" />
                            </div>
                            <span asp-validation-for="Email" class="field-validation-error small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted">
                                    <span class="iconify" data-icon="radix-icons:lock-closed"></span>
                                </span>
                                <input asp-for="Password" id="inputPassword" class="form-control border-start-0 ps-0" type="password" autocomplete="current-password" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="field-validation-error small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center gap-2 mb-4 auth-form-links">
                            <div class="form-check mb-0">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small">Ghi nhớ đăng nhập</label>
                            </div>
                            <a asp-action="ForgotPassword" class="small text-decoration-none">Quên mật khẩu?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
                            Đăng nhập
                        </button>
                    </form>
                </div>

                <div class="auth-footer text-start mt-3">
                    <span class="small text-muted">Chưa có tài khoản?</span>
                    <a asp-controller="Account" asp-action="Register" class="small text-decoration-none fw-semibold ms-1">Đăng ký tài khoản</a>
                    <span class="mx-1 text-muted">·</span>
                    <a asp-action="ResendVerification" class="small text-decoration-none text-muted">Gửi lại email xác minh</a>
                </div>
            </div>

            <!-- Right Side: High-Fidelity Feature Showcase (AuthKit Style) -->
            <div class="auth-showcase-panel">
                <span class="auth-showcase-eyebrow">
                    <span class="iconify" data-icon="radix-icons:rocket"></span> NỀN TẢNG ÔN THI THẾ HỆ MỚI
                </span>

                <h2 class="auth-showcase-title">
                    Học sâu, nhớ lâu và thi đấu tương tác trực tiếp
                </h2>

                <p class="auth-showcase-desc">
                    Hệ thống tích hợp phòng thi đấu trắc nghiệm trực tiếp, phương pháp ghi nhớ thông minh và nhóm học tập tương tác.
                </p>

                <div class="text-center my-3 py-1">
                    <div id="lottie-rocket-hero" style="width: 140px; height: 140px; margin: 0 auto; filter: drop-shadow(0 12px 24px rgba(102, 58, 243, 0.4));"></div>
                </div>

                <div class="auth-feature-cards">
                    <!-- Feature 1: Kahoot Live -->
                    <div class="auth-feature-card">
                        <div class="auth-feature-icon" style="background: rgba(102, 58, 243, 0.18); color: #a78bfa;">
                            <span class="iconify" data-icon="lucide:gamepad-2"></span>
                        </div>
                        <div class="auth-feature-content flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between">
                                <h4>Đấu trường Kahoot Live</h4>
                                <span class="badge rounded-pill" style="background: rgba(34, 197, 94, 0.2); color: #4ade80; font-size: 0.7rem; border: 1px solid rgba(34, 197, 94, 0.3);">
                                    ● Trực tiếp
                                </span>
                            </div>
                            <p>Tham gia phòng thi bằng mã PIN hoặc quét QR trực tiếp từ ứng dụng điện thoại.</p>
                        </div>
                    </div>

                    <!-- Feature 2: Flashcards & SRS -->
                    <div class="auth-feature-card">
                        <div class="auth-feature-icon" style="background: rgba(56, 189, 248, 0.16); color: #38bdf8;">
                            <span class="iconify" data-icon="radix-icons:layers"></span>
                        </div>
                        <div class="auth-feature-content flex-grow-1">
                            <h4>Học Flashcard ghi nhớ thông minh</h4>
                            <p>Tối ưu hóa khả năng ghi nhớ dài hạn với cơ chế tự động ôn tập theo độ khó của từng thẻ.</p>
                        </div>
                    </div>

                    <!-- Feature 3: Nhóm học tập -->
                    <div class="auth-feature-card">
                        <div class="auth-feature-icon" style="background: rgba(245, 158, 11, 0.16); color: #fbbf24;">
                            <span class="iconify" data-icon="radix-icons:chat-bubble"></span>
                        </div>
                        <div class="auth-feature-content flex-grow-1">
                            <h4>Phòng thảo luận & Chat nhóm</h4>
                            <p>Trao đổi câu hỏi, chia sẻ tài liệu và thảo luận bài giải ngay lập tức với giảng viên và bạn học.</p>
                        </div>
                    </div>
                </div>

                <!-- Stats Ribbon -->
                <div class="auth-stat-ribbon">
                    <div class="auth-stat-item">
                        <span class="auth-stat-value">10,000+</span>
                        <span class="auth-stat-label">Câu hỏi & Thẻ bài</span>
                    </div>
                    <div class="auth-stat-item">
                        <span class="auth-stat-value">100%</span>
                        <span class="auth-stat-label">Đồng bộ Web & App</span>
                    </div>
                    <div class="auth-stat-item">
                        <span class="auth-stat-value">&lt; 50ms</span>
                        <span class="auth-stat-label">Tốc độ phản hồi</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            var container = document.getElementById('lottie-rocket-hero');
            if (container && window.lottie) {
                window.lottie.loadAnimation({
                    container: container,
                    renderer: 'svg',
                    loop: true,
                    autoplay: true,
                    path: '/assets/lottie/rocket.json'
                });
            }
        })();
    </script>
}
