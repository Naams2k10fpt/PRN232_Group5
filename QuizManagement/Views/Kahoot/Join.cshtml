@{
    ViewData["Title"] = "Tham gia phòng Kahoot";
    string prefilledCode = ViewBag.RoomCode as string ?? "";
}

<div class="container py-5 min-vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #1368ce 0%, #46178f 100%);">
    <div class="card shadow-lg border-0 rounded-4 p-4 text-center" style="max-width: 420px; width: 100%;">
        <div class="mb-3">
            <h1 class="fw-bolder text-primary mb-1 display-5">KAHOOT!</h1>
            <p class="text-muted">Nhập mã PIN hoặc quét mã QR để tham gia</p>
        </div>

        <form id="joinForm" onsubmit="handleJoin(event)">
            <div class="mb-3">
                <input type="text" id="roomCodeInput" class="form-control form-control-lg text-center fw-bold fs-3 text-uppercase"
                       placeholder="MÃ PIN (6 SỐ)" maxlength="10" value="@prefilledCode" required autofocus />
            </div>
            <div class="mb-4">
                <input type="text" id="nicknameInput" class="form-control form-control-lg text-center fs-4"
                       placeholder="Biệt danh (Nickname)" maxlength="20" required />
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-dark btn-lg py-3 fw-bold rounded-3 shadow">
                    THAM GIA NGAY
                </button>
            </div>
        </form>

        <div class="mt-4 text-muted small">
            Quiz Management Live Multiplayer
        </div>
    </div>
</div>

<script>
    function handleJoin(e) {
        e.preventDefault();
        const code = document.getElementById("roomCodeInput").value.trim().toUpperCase();
        const nick = document.getElementById("nicknameInput").value.trim();
        if (code && nick) {
            window.location.href = `/Kahoot/Play?roomCode=${encodeURIComponent(code)}&nickname=${encodeURIComponent(nick)}`;
        }
    }
</script>
