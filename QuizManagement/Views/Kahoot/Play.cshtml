@model BusinessObjects.KahootRoom
@{
    ViewData["Title"] = "Kahoot Player: " + Model.RoomCode;
    string nickname = ViewBag.Nickname as string ?? "Player";
    Layout = null; // Fullscreen app layout for mobile and web
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Quiz Arena - @nickname</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script src="https://code.iconify.design/3/3.1.1/iconify.min.js"></script>
    <style>
        body, html {
            height: 100%;
            margin: 0;
            overflow: hidden;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: radial-gradient(circle at 50% 20%, #1e1b4b 0%, #0f172a 70%, #020617 100%);
            user-select: none;
            color: white;
        }

        .arena-btn {
            width: 100%;
            height: 100%;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
            padding: 12px;
            text-align: center;
        }
        .arena-btn:active {
            transform: scale(0.94);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
        }
        .arena-btn.selected-shockwave {
            animation: shockwavePulse 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border-color: #ffffff !important;
            box-shadow: 0 0 35px rgba(255, 255, 255, 0.95), 0 0 15px currentColor !important;
        }
        @@keyframes shockwavePulse {
            0% { transform: scale(0.92); }
            50% { transform: scale(1.08); filter: brightness(1.3); }
            100% { transform: scale(1); filter: brightness(1); }
        }

        .btn-arena-a { background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%); }
        .btn-arena-b { background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); }
        .btn-arena-c { background: linear-gradient(135deg, #f59e0b 0%, #b45309 100%); }
        .btn-arena-d { background: linear-gradient(135deg, #10b981 0%, #047857 100%); }

        .btn-letter {
            font-size: 2.8rem;
            font-weight: 900;
            line-height: 1;
            margin-bottom: 4px;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        }

        .btn-snippet {
            font-size: 1rem;
            font-weight: 600;
            opacity: 0.95;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            word-break: break-word;
        }

        .fullscreen-container {
            height: 100vh;
            display: flex;
            flex-direction: column;
        }
    </style>
</head>
<body>

<div class="fullscreen-container">
    <!-- Top Player Bar -->
    <div class="d-flex justify-content-between align-items-center px-4 py-3 bg-dark bg-opacity-50 border-bottom border-light border-opacity-10">
        <div class="d-flex align-items-center gap-2">
            <span class="iconify fs-4 text-info" data-icon="radix-icons:avatar"></span>
            <div>
                <span class="fw-bold fs-5">@nickname</span>
                <span class="badge bg-secondary ms-2 small">PIN: @Model.RoomCode</span>
            </div>
        </div>
        <div>
            <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill fw-bold" id="scoreBadge">0 pts</span>
        </div>
    </div>

    <!-- 1. Lobby Waiting Screen -->
    <div id="screenLobby" class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center p-4">
        <div class="spinner-grow text-info mb-4" style="width: 4.5rem; height: 4.5rem;" role="status"></div>
        <h2 class="fw-bold mb-2">ĐÃ SẴN SÀNG CHIẾN ĐẤU!</h2>
        <p class="fs-5 text-white-50">Bạn đã vào đấu trường. Đang chờ chủ phòng bắt đầu trận...</p>
    </div>

    <!-- 2. Gameplay 4 Buttons Screen -->
    <div id="screenAnswering" class="flex-grow-1 p-3 d-none">
        <div class="row g-3 h-100 m-0">
            <div class="col-6 p-1">
                <button class="arena-btn btn-arena-a" onclick="submitChoice(0)">
                    <span class="btn-letter">A</span>
                    <span class="btn-snippet" id="txtBtn0">Đáp án A</span>
                </button>
            </div>
            <div class="col-6 p-1">
                <button class="arena-btn btn-arena-b" onclick="submitChoice(1)">
                    <span class="btn-letter">B</span>
                    <span class="btn-snippet" id="txtBtn1">Đáp án B</span>
                </button>
            </div>
            <div class="col-6 p-1">
                <button class="arena-btn btn-arena-c" onclick="submitChoice(2)">
                    <span class="btn-letter">C</span>
                    <span class="btn-snippet" id="txtBtn2">Đáp án C</span>
                </button>
            </div>
            <div class="col-6 p-1">
                <button class="arena-btn btn-arena-d" onclick="submitChoice(3)">
                    <span class="btn-letter">D</span>
                    <span class="btn-snippet" id="txtBtn3">Đáp án D</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 3. Answer Submitted Waiting Screen -->
    <div id="screenSubmitted" class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center p-4 d-none">
        <span class="iconify text-success display-1 mb-3" data-icon="radix-icons:check-circled"></span>
        <h2 class="fw-bold mb-2">ĐÃ KHÓA LỰA CHỌN!</h2>
        <p class="fs-5 text-white-50">Đang chờ thời gian kết thúc để chấm điểm...</p>
    </div>

    <!-- 4. Result Feedback Screen -->
    <div id="screenResult" class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center p-4 d-none">
        <div id="resultIcon" class="display-1 mb-2"></div>
        <h1 id="resultText" class="display-4 fw-bolder mb-2"></h1>
        <h3 id="resultScore" class="fw-bold text-warning mb-4"></h3>
        <p class="text-white-50 fs-5">Hãy nhìn lên màn hình chính để xem thứ hạng!</p>
    </div>

    <!-- 5. Game Over Screen -->
    <div id="screenGameOver" class="flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center p-4 d-none">
        <div class="mb-3 text-warning d-flex justify-content-center">
            <span class="iconify" data-icon="radix-icons:star-filled" style="font-size: 4.5rem;"></span>
        </div>
        <h1 class="display-4 fw-bolder mb-2">HOÀN THÀNH TRẬN ĐẤU!</h1>
        <h3 class="fw-bold text-light mb-4">Tổng điểm chiến đấu: <span id="finalScore" class="text-warning">0</span> pts</h3>
        <a href="/Kahoot/Join" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow">
            Tham gia trận khác
        </a>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="~/js/gamification.js"></script>
<script>
    const roomCode = "@Model.RoomCode";
    const nickname = "@nickname";
    let participantId = 0;
    let currentQuestion = null;
    let questionStartTime = 0;
    let totalScore = 0;

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/kahoot")
        .withAutomaticReconnect()
        .build();

    function showScreen(screenId) {
        ["screenLobby", "screenAnswering", "screenSubmitted", "screenResult", "screenGameOver"].forEach(id => {
            document.getElementById(id).classList.add("d-none");
        });
        document.getElementById(screenId).classList.remove("d-none");
    }

    connection.on("JoinedSuccess", function(data) {
        participantId = data.participantId;
        console.log("Joined as Participant ID:", participantId);
    });

    connection.on("ReceiveQuestion", function(q) {
        currentQuestion = q;
        questionStartTime = Date.now();

        // Cập nhật text hiển thị trên 4 nút A, B, C, D
        for (let i = 0; i < 4; i++) {
            const txtEl = document.getElementById(`txtBtn${i}`);
            const btnEl = txtEl ? txtEl.closest("button") : null;
            if (i < q.answers.length) {
                if (btnEl) btnEl.parentElement.classList.remove("d-none");
                if (txtEl) txtEl.innerText = q.answers[i].text;
            } else {
                if (btnEl) btnEl.parentElement.classList.add("d-none");
            }
        }

        showScreen("screenAnswering");
    });

    connection.on("AnswerResult", function(res) {
        totalScore = res.totalScore;
        document.getElementById("scoreBadge").innerText = `${totalScore} pts`;

        const resultIcon = document.getElementById("resultIcon");
        const resultText = document.getElementById("resultText");
        const resultScore = document.getElementById("resultScore");

        if (res.isCorrect) {
            resultIcon.innerHTML = '<span class="iconify text-success" data-icon="radix-icons:check-circled" style="font-size: 5rem;"></span>';
            resultText.innerText = "CHÍNH XÁC!";
            resultText.className = "display-4 fw-bolder text-success mb-2";
            resultScore.innerText = `+${res.scoreEarned} điểm`;
            if (window.QuizCelebration) {
                window.QuizCelebration.confetti({ particleCount: 35, duration: 1600 });
            }
        } else {
            resultIcon.innerHTML = '<span class="iconify text-danger" data-icon="radix-icons:cross-circled" style="font-size: 5rem;"></span>';
            resultText.innerText = "CHƯA ĐÚNG!";
            resultText.className = "display-4 fw-bolder text-danger mb-2";
            resultScore.innerText = "+0 điểm";
        }

        showScreen("screenResult");
    });

    connection.on("GameOver", function() {
        document.getElementById("finalScore").innerText = totalScore;
        showScreen("screenGameOver");
        if (window.QuizCelebration) {
            window.QuizCelebration.confetti({ particleCount: 120 });
            window.QuizCelebration.playVictoryChime();
        }
    });

    function submitChoice(colorIndex) {
        if (!currentQuestion || !participantId) return;

        const elapsedSeconds = ((Date.now() - questionStartTime) / 1000).toFixed(2);
        const selectedAnswer = currentQuestion.answers.find(a => a.colorIndex === colorIndex);
        const selectedAnswerId = selectedAnswer ? selectedAnswer.id : 0;

        const btn = document.querySelector(`.btn-arena-${['a','b','c','d'][colorIndex]}`);
        if (btn) btn.classList.add('selected-shockwave');

        setTimeout(() => {
            showScreen("screenSubmitted");
        }, 180);

        connection.invoke("SubmitAnswer",
            roomCode,
            participantId,
            currentQuestion.questionId,
            selectedAnswerId,
            parseFloat(elapsedSeconds)
        ).catch(err => console.error("Error submitting answer: ", err));
    }

    connection.start().then(function() {
        console.log("Connected to KahootHub as Player");
        connection.invoke("JoinRoom", roomCode, nickname, "");
    }).catch(err => console.error("SignalR Error: ", err));
</script>
</body>
</html>
