@using BusinessObjects
@{
    ViewData["Title"] = "Đấu trường Kahoot Live";
    var decks = ViewBag.Decks as IEnumerable<Deck> ?? Enumerable.Empty<Deck>();
}

<style>
    .arena-hero {
        position: relative;
        padding: 2.5rem 0 1.5rem;
    }
    .arena-create-card {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        backdrop-filter: blur(20px);
    }
    .arena-create-header {
        background: linear-gradient(135deg, rgba(124, 109, 248, 0.15) 0%, rgba(34, 211, 238, 0.08) 100%);
        border-bottom: 1px solid var(--border);
        padding: 1.75rem 2rem;
    }
    .feature-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        color: var(--text-muted);
        padding: 0.4rem 0.85rem;
        border-radius: var(--r-full);
        font-size: 0.85rem;
        font-weight: 500;
    }
    .form-control-custom, .form-select-custom {
        background: var(--bg-elevated) !important;
        border: 1px solid var(--border) !important;
        color: var(--text) !important;
        border-radius: var(--r-lg) !important;
        padding: 0.75rem 1rem !important;
        transition: border-color var(--t), box-shadow var(--t) !important;
    }
    .form-control-custom:focus, .form-select-custom:focus {
        border-color: var(--accent) !important;
        box-shadow: 0 0 0 3px var(--accent-light) !important;
        outline: none !important;
    }
    .form-select-custom optgroup {
        background: var(--bg-surface);
        color: var(--accent);
        font-weight: 700;
    }
    .form-select-custom option {
        background: var(--bg-elevated);
        color: var(--text);
    }
    .btn-create-arena {
        background-color: #4f46e5 !important;
        background-image: linear-gradient(135deg, var(--accent) 0%, #4f46e5 100%) !important;
        color: #ffffff !important;
        border: none;
        padding: 1rem 2rem;
        font-size: 1.1rem;
        font-weight: 700;
        border-radius: var(--r-lg);
        box-shadow: 0 4px 20px rgba(124, 109, 248, 0.4);
        transition: all var(--t);
    }
    .btn-create-arena:hover {
        background-color: #3730a3 !important;
        background-image: linear-gradient(135deg, var(--accent-hover) 0%, #3730a3 100%) !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(124, 109, 248, 0.6);
        color: #ffffff !important;
    }
    .join-link-box {
        background: var(--bg-hover);
        border: 1px dashed var(--border-strong);
        border-radius: var(--r-lg);
        padding: 1rem 1.5rem;
        transition: border-color var(--t), background var(--t);
    }
    .join-link-box:hover {
        border-color: var(--cyan);
        background: var(--cyan-light);
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center arena-hero">
        <div class="col-lg-8">
            <div class="arena-create-card">
                <div class="arena-create-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge d-inline-flex align-items-center gap-1" style="background:var(--accent-light); color:var(--accent); font-weight:700;">
                                <span class="iconify" data-icon="lucide:radio"></span> LIVE ARENA
                            </span>
                            <span class="badge" style="background:var(--cyan-light); color:var(--cyan); font-weight:700;">
                                Multiplayer Realtime
                            </span>
                        </div>
                        <h3 class="fw-bold mb-0">Tạo Phòng Thi Đấu Kahoot Live</h3>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="feature-chip d-inline-flex align-items-center gap-1"><span class="iconify text-info" data-icon="lucide:qr-code"></span> Mã QR</span>
                        <span class="feature-chip d-inline-flex align-items-center gap-1"><span class="iconify text-warning" data-icon="radix-icons:mobile"></span> App Mobile</span>
                    </div>
                </div>

                <div class="p-4 p-md-5">
                    <p class="text-muted mb-4" style="line-height: 1.6;">
                        Chọn bộ đề trắc nghiệm để mở đấu trường thời gian thực. Hệ thống tự động tạo
                        <strong class="text-body fw-bold">mã PIN 6 số</strong> và <strong class="text-body fw-bold">mã QR</strong>.
                        Người tham gia có thể dùng ứng dụng di động hoặc trình duyệt để quét mã và tranh tài ngay tức thì!
                    </p>

                    <form asp-action="CreateRoom" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-semibold d-flex align-items-center gap-1">
                                <span class="iconify text-primary" data-icon="radix-icons:text"></span> Tên phòng thi đấu
                            </label>
                            <input type="text" name="title" class="form-control form-control-custom form-control-lg"
                                   placeholder="Ví dụ: Đấu trường PRN232 - Vòng chung kết" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold d-flex align-items-center gap-1">
                                <span class="iconify text-info" data-icon="radix-icons:card-stack"></span> Chọn bộ đề câu hỏi (Deck)
                            </label>
                            <select name="deckId" class="form-select form-select-custom form-select-lg" required>
                                <option value="">-- Chọn bộ đề để thi đấu --</option>
                                @foreach (var group in decks.GroupBy(d => d.Subject?.Name ?? "Môn học chung"))
                                {
                                    <optgroup label="Môn: @group.Key">
                                        @foreach (var deck in group)
                                        {
                                            <option value="@deck.Id">@deck.Name (@deck.Questions.Count(q => !q.IsDeleted) câu hỏi)</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-create-arena d-flex align-items-center justify-content-center gap-2">
                                <span class="iconify fs-5" data-icon="radix-icons:play"></span> Khởi tạo phòng & Tạo mã tham gia
                            </button>
                        </div>
                    </form>

                    <div class="mt-4 pt-3 border-top" style="border-color: var(--border) !important;">
                        <a asp-action="Join" class="text-decoration-none">
                            <div class="join-link-box d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                                         style="width: 40px; height: 40px; background: var(--cyan-light); color: var(--cyan);">
                                        <span class="iconify fs-5" data-icon="radix-icons:enter"></span>
                                    </div>
                                    <div>
                                        <div class="fw-bold">Bạn là thí sinh tham gia?</div>
                                        <div class="text-muted small">Bấm vào đây để nhập mã PIN hoặc biệt danh vào phòng</div>
                                    </div>
                                </div>
                                <span class="iconify text-muted fs-5" data-icon="radix-icons:chevron-right"></span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

