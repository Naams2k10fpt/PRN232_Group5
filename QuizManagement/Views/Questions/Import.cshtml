@model QuestionImportInputViewModel
@using Services
@{
    ViewData["Title"] = "Import câu hỏi";
}

<style>
    .import-hero-card {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        padding: 1.75rem 2rem;
        box-shadow: var(--shadow);
    }
    .template-box {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        padding: 1.5rem;
    }
    .template-btn-excel {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid rgba(16, 185, 129, 0.4);
        color: #34d399;
        font-weight: 700;
        transition: all var(--t);
    }
    .template-btn-excel:hover {
        background: #10b981;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    }
    .template-btn-text {
        background: var(--cyan-light);
        border: 1px solid rgba(34, 211, 238, 0.4);
        color: var(--cyan);
        font-weight: 700;
        transition: all var(--t);
    }
    .template-btn-text:hover {
        background: var(--cyan);
        color: #0b1120;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(34, 211, 238, 0.4);
    }
    .import-panel {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        padding: 1.75rem;
        box-shadow: var(--shadow);
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .import-textarea {
        background: var(--bg-elevated) !important;
        border: 1px solid var(--border) !important;
        color: var(--text) !important;
        border-radius: var(--r-lg) !important;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.92rem;
        padding: 1rem;
        transition: border-color var(--t);
    }
    .import-textarea:focus {
        border-color: var(--accent) !important;
        box-shadow: 0 0 0 3px var(--accent-light) !important;
        outline: none !important;
    }
    .file-drop-zone {
        background: var(--bg-elevated);
        border: 2px dashed var(--border-strong);
        border-radius: var(--r-lg);
        padding: 2rem 1.5rem;
        text-align: center;
        transition: border-color var(--t), background var(--t);
    }
    .file-drop-zone:hover {
        border-color: var(--accent);
        background: var(--accent-light);
    }
</style>

<div class="container py-4">
    <!-- Header -->
    <div class="import-hero-card d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge d-inline-flex align-items-center gap-1" style="background:var(--accent-light); color:var(--accent); font-weight:700;">
                    <span class="iconify" data-icon="radix-icons:download"></span> IMPORT DỮ LIỆU
                </span>
                <span class="badge" style="background:var(--cyan-light); color:var(--cyan); font-weight:700;">
                    @Model.SubjectName
                </span>
            </div>
            <h2 class="fw-bold mb-0 text-white">Import câu hỏi vào: @Model.DeckName</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Questions" asp-action="Index" asp-route-deckId="@Model.DeckId" class="btn btn-outline-secondary rounded-pill px-3 d-flex align-items-center gap-1">
                <span class="iconify" data-icon="radix-icons:arrow-left"></span> Quay lại câu hỏi
            </a>
        </div>
    </div>

    <!-- Tải File Mẫu (Templates) Section -->
    <div class="template-box mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h5 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                    <span class="iconify text-warning" data-icon="radix-icons:download"></span>Tải mẫu nhập liệu câu hỏi chuẩn
                </h5>
                <p class="text-muted small mb-0">Tải file mẫu về máy, điền câu hỏi theo các cột/cú pháp rồi tải lên lại bên dưới để tránh lỗi định dạng.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="QuestionImport" asp-action="DownloadTemplate" class="btn template-btn-excel rounded-pill px-4 py-2 d-flex align-items-center gap-2">
                    <span class="iconify fs-5" data-icon="lucide:file-spreadsheet"></span> Tải File Excel Mẫu (.xlsx)
                </a>
                <a asp-controller="QuestionImport" asp-action="DownloadTextTemplate" class="btn template-btn-text rounded-pill px-4 py-2 d-flex align-items-center gap-2">
                    <span class="iconify fs-5" data-icon="radix-icons:file-text"></span> Tải File Text Mẫu (.txt)
                </a>
            </div>
        </div>
    </div>

    <!-- Form Import -->
    <form asp-controller="QuestionImport" asp-action="Preview" method="post" enctype="multipart/form-data">
        <input asp-for="DeckId" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger mb-4 d-none" id="valSummary"></div>

        <div class="row g-4">
            <!-- Cột trái: Tải lên file Excel -->
            <div class="col-lg-6">
                <div class="import-panel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                            <span class="iconify text-success" data-icon="lucide:file-spreadsheet"></span> Cách 1: Tải file Excel
                        </h4>
                        <span class="badge bg-success bg-opacity-25 text-success">Khuyên dùng</span>
                    </div>
                    <p class="text-muted small mb-4">
                        Hỗ trợ file định dạng <strong>.xlsx</strong>. Tối đa @(QuestionImportLimits.MaxUploadBytes / 1024 / 1024) MB và @QuestionImportLimits.MaxRows.ToString("N0") câu hỏi/lần.
                    </p>

                    <div class="file-drop-zone my-auto">
                        <span class="iconify display-4 text-accent mb-3 d-block mx-auto" data-icon="radix-icons:upload" style="color:var(--accent);"></span>
                        <label for="ExcelFile" class="form-label fw-bold text-white mb-2 cursor-pointer">
                            Nhấn vào đây để chọn file Excel từ máy
                        </label>
                        <input asp-for="ExcelFile" class="form-control" type="file" accept=".xlsx" style="background:var(--bg-surface); color:var(--text); border-color:var(--border);" />
                        <div class="text-muted small mt-2">
                            Header hỗ trợ: Question, Type, Answer1, Correct1, Answer2, Correct2, Explanation...
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Dán văn bản text trực tiếp -->
            <div class="col-lg-6">
                <div class="import-panel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                            <span class="iconify text-info" data-icon="radix-icons:text"></span> Cách 2: Dán nội dung Text
                        </h4>
                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill d-flex align-items-center gap-1" onclick="insertSampleText()">
                            <span class="iconify" data-icon="radix-icons:clipboard-copy"></span> Dán nội dung mẫu
                        </button>
                    </div>
                    <p class="text-muted small mb-3">
                        Dán trực tiếp danh sách câu hỏi. Dùng <code>*</code> cho đáp án Đúng, <code>-</code> cho đáp án Sai.
                    </p>

                    <textarea asp-for="RawText" id="rawTextArea" class="form-control import-textarea flex-grow-1" rows="12"
                              placeholder="Question: 2 + 2 bằng mấy?&#10;Type: single&#10;* 4&#10;- 3&#10;- 5&#10;Explanation: 2 cộng 2 bằng 4."></textarea>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-2">
            <a asp-controller="Questions" asp-action="Index" asp-route-deckId="@Model.DeckId" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                Hủy bỏ
            </a>
            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow d-flex align-items-center gap-2">
                <span class="iconify fs-5" data-icon="radix-icons:eye-open"></span> Xem trước & Kiểm tra câu hỏi
            </button>
        </div>
    </form>

    <!-- Mẫu tham khảo dưới cùng -->
    <div class="mt-5 pt-3 border-top" style="border-color:var(--border)!important;">
        <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
            <span class="iconify text-muted" data-icon="radix-icons:code"></span>Cấu trúc cú pháp Text chi tiết:
        </h5>
        <pre class="p-3 rounded-4 text-wrap mb-0" style="background:var(--bg-elevated); color:var(--cyan); border:1px solid var(--border); font-family:monospace; font-size:0.9rem;" id="sampleTemplatePre">@Model.TextTemplate</pre>
    </div>
</div>

<script>
    function insertSampleText() {
        const template = document.getElementById("sampleTemplatePre").innerText;
        document.getElementById("rawTextArea").value = template;
        document.getElementById("rawTextArea").focus();
    }
</script>

