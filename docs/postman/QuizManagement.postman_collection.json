{
  "info": {
    "_postman_id": "1df1b02a-086b-5565-af4b-fb593f112a8b",
    "name": "Quiz Management Mobile API",
    "description": "Mobile REST API (PRM393). Run **Auth / Login** first: it stores `accessToken` for the other requests.\n\n`baseUrl`: `http://localhost:5039` (local) or `https://prn232-group5.onrender.com` (Render; first request after idle can take ~60 s). Demo account: `user.demo@quiz.local` / `Test@123456`.\n\nErrors are `{ code, message, errors?, retryAfterSeconds? }`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5039"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "subjectId",
      "value": ""
    },
    {
      "key": "deckId",
      "value": ""
    },
    {
      "key": "questionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "200 → stores accessToken. 401 invalid_credentials, 403 account_disabled / email_not_confirmed, 429 locked_out.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.demo@quiz.local\",\n  \"password\": \"Test@123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "201, no token: the user must confirm the emailed link before logging in. 409 registration_conflict.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"new_user\",\n  \"email\": \"new.user@example.com\",\n  \"password\": \"a long passphrase\",\n  \"confirmPassword\": \"a long passphrase\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Resend verification email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-verification"
              ]
            },
            "description": "Always 202.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.user@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Always 202. The emailed link opens the web reset page.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user.demo@quiz.local\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profile"
              ]
            },
            "description": "401 unauthorized when the token is missing, expired or revoked.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profile"
              ]
            },
            "description": "400 validation_failed with errors.username when the name is taken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user_demo\",\n  \"avatarUrl\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/profile/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profile",
                "change-password"
              ]
            },
            "description": "Revokes every old token; stores the returned one. Do not run against the shared demo account on Render.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Test@123456\",\n  \"newPassword\": \"a new long passphrase\",\n  \"confirmPassword\": \"a new long passphrase\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Subjects",
      "item": [
        {
          "name": "List subjects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/subjects?search=&page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subjects"
              ],
              "query": [
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": "Subjects with their deck and question counts. `search` matches the name (case-insensitive); `pageSize` is capped at 100. Stores the first subject's id as `subjectId`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().items.length > 0) {",
                  "  pm.collectionVariables.set('subjectId', pm.response.json().items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get subject",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/subjects/{{subjectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subjects",
                "{{subjectId}}"
              ]
            },
            "description": "404 subject_not_found when the subject does not exist or was deleted.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Decks",
      "item": [
        {
          "name": "List decks of a subject",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/subjects/{{subjectId}}/decks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subjects",
                "{{subjectId}}",
                "decks"
              ]
            },
            "description": "Decks with the signed-in user's flashcard progress: `dueCount` (new or due cards), `learnedCount`, `nextReviewAtUtc`. 404 subject_not_found for an unknown subject. Stores the first deck's id as `deckId`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().length > 0) {",
                  "  pm.collectionVariables.set('deckId', pm.response.json()[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deck",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/decks/{{deckId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "decks",
                "{{deckId}}"
              ]
            },
            "description": "404 deck_not_found when the deck does not exist or was deleted.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Flashcards",
      "item": [
        {
          "name": "List flashcards",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/decks/{{deckId}}/flashcards?mode=due",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "decks",
                "{{deckId}}",
                "flashcards"
              ],
              "query": [
                {
                  "key": "mode",
                  "value": "due"
                }
              ]
            },
            "description": "`mode=due` (default): new cards and cards whose review time has passed; `mode=all`: every card. `content` and `explanation` are Markdown; `progress` is null for a card never reviewed. 400 validation_failed for another mode, 404 deck_not_found. Stores the first card's id as `questionId`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().cards.length > 0) {",
                  "  pm.collectionVariables.set('questionId', pm.response.json().cards[0].questionId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Save review progress",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/flashcards/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "flashcards",
                "progress"
              ]
            },
            "description": "Saves whether the user remembered the card and returns its next review time. 400 validation_failed for a missing/invalid field, 404 question_not_found when the question is not in the deck.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deckId\": {{deckId}},\n  \"questionId\": {{questionId}},\n  \"remembered\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
